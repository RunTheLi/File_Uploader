<!-- views/folder-details.ejs -->
<%- include("partials/header", { title: folder.name }) %>

<div style="display: flex; justify-content: space-between; align-items: center;">
  <h1>📁 Folder: <%= folder.name %></h1>
  
  <!-- ปุ่มสำหรับลบ Folder -->
  <form action="/folders/<%= folder.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this folder and all its files?');">
    <button type="submit" style="background: #dc3545; color: white; border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer;">Delete Folder</button>
  </form>
</div>

<a href="/">⬅️ Back to Home</a>

<hr>

<!-- ฟอร์มสำหรับ Upload ไฟล์เข้า Folder นี้ -->
<section style="background: #f1f1f1; padding: 15px; border-radius: 5px;">
  <h3>Upload File to this Folder</h3>
  <form action="/files/upload" method="POST" enctype="multipart/form-data">
    <!-- ส่ง folderId ไปด้วย เพื่อบอกว่าไฟล์นี้อยู่โฟลเดอร์ไหน -->
    <input type="hidden" name="folderId" value="<%= folder.id %>">
    <input type="file" name="file" required>
    <button type="submit">Upload File</button>
  </form>
</section>

<hr>

<!-- แสดงรายชื่อไฟล์ภายใน Folder -->
<section>
  <h3>Files in this Folder</h3>
  <% if (files && files.length > 0) { %>
    <ul>
      <% files.forEach(file => { %>
        <li>
          <a href="/files/<%= file.id %>">📄 <%= file.originalName %></a> 
          <span style="color: gray; font-size: 0.9em;">(<%= (file.size / 1024).toFixed(2) %> KB)</span>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>No files in this folder yet.</p>
  <% } %>
</section>

<!-- ส่วนจัดการการแชร์ Folder -->
<section style="background: #f8fafc; border: 1px dashed #cbd5e1; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
  <h3>🔗 Share Folder</h3>
  
  <% if (folder.shareToken && folder.shareExpiresAt > new Date()) { %>
    <p><strong>Share Link:</strong> <a href="/share/<%= folder.shareToken %>" target="_blank"><%= `${locals.protocol || 'http'}://${locals.host || 'localhost:3000'}/share/${folder.shareToken}` %></a></p>
    <p style="font-size: 0.85rem; color: #64748b;">Expires at: <%= new Date(folder.shareExpiresAt).toLocaleString() %></p>
  <% } else { %>
    <p style="font-size: 0.9rem; color: #64748b;">This folder is not currently shared.</p>
  <% } %>

  <form action="/folders/<%= folder.id %>/share" method="POST" style="display: flex; gap: 10px; align-items: center; margin-top: 10px;">
    <label for="duration" style="margin: 0; font-size: 0.9rem;">Duration:</label>
    <select name="duration" id="duration" style="padding: 5px; border-radius: 4px; border: 1px solid #cbd5e1;">
      <option value="1">1 Day</option>
      <option value="7">7 Days</option>
      <option value="30">30 Days</option>
    </select>
    <button type="submit" style="padding: 6px 12px; font-size: 0.9rem;">Generate / Update Link</button>
  </form>
</section>

<%- include("partials/footer") %>